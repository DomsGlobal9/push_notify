# Copy to your Render service's environment (or export locally). Never commit real values.
DEBUG=False
# Supabase transaction pooler (port 6543), password filled in
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DJANGO_SECRET_KEY=change-me
# 32 random bytes, base64. Back it up: without it stored credentials cannot be decrypted.
MASTER_ENCRYPTION_KEY=
ADMIN_API_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
RUN_DISPATCHER_INLINE=true

# Optional tuning
# PUSH_BATCH_SIZE=500
# PUSH_SEND_THREADS=64
# PUSH_MAX_SEND_ATTEMPTS=5
# PUSH_FAILURE_RETENTION_DAYS=14
# PUSH_NOTIFICATION_RETENTION_DAYS=90
# THROTTLE_SEND=600/min
# THROTTLE_DEVICE=6000/min
